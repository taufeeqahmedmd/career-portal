# Copy to frontend/.env and fill in.
#
# Create React App reads these at BUILD time, not at runtime: after changing
# anything here you must rebuild (`npm run build`) or restart `npm start`.

# Cloudflare Turnstile site key - pairs with TURNSTILE_SECRET_KEY in
# backend/.env. Leave empty to run without a captcha.
#
# If the backend has a secret key but this is empty, the widget never renders
# and every submission is rejected. The form detects that and says so.
REACT_APP_TURNSTILE_SITE_KEY=

# Timezone used to build the dashboard's day buckets. Must match APP_TIMEZONE
# in backend/.env, or the chart and the "today" figure disagree overnight.
# Defaults to Asia/Kolkata.
REACT_APP_TIMEZONE=Asia/Kolkata

# API base URL. Leave unset in production - the app calls /api on its own
# origin, which nginx proxies to the backend.
# REACT_APP_API_URL=http://localhost:5001/api
