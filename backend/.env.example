# Server port
PORT=5001

# PostgreSQL connection string
DATABASE_URL=postgres://careers:careers@localhost:5432/careers
# Optional: pool size (default 10)
# PG_POOL_SIZE=10

# Timezone for day boundaries ("today", date filters, dashboard trend).
# Should match the timezone your admins work in. Default: UTC
APP_TIMEZONE=Asia/Kolkata

# Optional rate limits (requests per window)
# RATE_LIMIT_LOGIN=10             # failed sign-ins per 15 min
# RATE_LIMIT_APPLY=15             # applications per hour per IP
# RATE_LIMIT_PUBLIC=300           # public API reads per minute per IP
# RATE_LIMIT_PASSWORD_RESET=5     # reset codes requested per 15 min
# RATE_LIMIT_PASSWORD_REDEEM=15   # wrong reset codes per 15 min
# RATE_LIMIT_TOTP=12              # wrong 2FA codes per 15 min

# REQUIRED IN PRODUCTION when the app runs behind nginx / Cloudflare / a load
# balancer. Without it every visitor shares one rate-limit bucket: a handful of
# failed logins locks out all admins, and the application form stops accepting
# submissions site-wide once the hourly limit is hit. Set to the number of
# proxies in front of this process (1 for a single nginx), or a comma-separated
# list of trusted proxy addresses. Leave unset only if exposed directly.
TRUST_PROXY=

# Comma-separated origins allowed to call the API. Unset = any origin.
# e.g. ALLOWED_ORIGINS=https://careers.example.org
ALLOWED_ORIGINS=

# Seeds sample branches and job openings on a BRAND-NEW database. Handy in
# development; leave unset in production or the careers site goes live showing
# vacancies nobody created. Existing databases are never touched.
SEED_SAMPLE_DATA=

# ---- Accounts and sessions ----
# Password every new account starts on; the owner must replace it at first
# sign-in before they can use the portal.
INITIAL_USER_PASSWORD=12345678
# Days that temporary password stays usable before an admin must re-issue it.
# 0 disables the expiry.
INITIAL_PASSWORD_DAYS=7
# Minutes a "forgot password" code stays valid (1-60)
PASSWORD_RESET_MINUTES=15
# Name shown in authenticator apps next to the two-factor entry
TOTP_ISSUER=Careers Portal
SESSION_HOURS=8
TOTP_CHALLENGE_MINUTES=10

# Largest CSV export a single request will build
EXPORT_MAX_ROWS=20000

# ---- Cloudflare Turnstile (captcha on sign-in and the application form) ----
# Get both keys from Cloudflare Dashboard > Turnstile > Add site. The secret
# goes here; the site key goes in frontend/.env as REACT_APP_TURNSTILE_SITE_KEY.
# While this is empty the captcha is skipped entirely.
# Cloudflare's test keys: 1x0000000000000000000000000000000AA always passes,
# 2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=

# ---- Application form: anti-spam ----
# The honeypot field, the PDF signature check and the per-applicant daily cap
# are always on. These are the switches.
#
# REQUIRE_FORM_TOKEN: submissions without an API key must present a token from
# GET /api/form-token, proving the form was fetched from us and took a human
# amount of time to fill in. Enable once the frontend requesting it is deployed.
REQUIRE_FORM_TOKEN=false
# REQUIRE_API_KEY: reject every submission that carries no key. This locks out
# the portal's own browser form - only for API-only instances.
REQUIRE_API_KEY=false
FORM_MIN_SECONDS=3
FORM_MAX_SECONDS=7200
# Positions one person may apply for in 24 hours, across all vacancies (0 = off)
MAX_APPLICATIONS_PER_DAY=8
# Applications per hour from one keyless IP
RATE_LIMIT_APPLY=15

# Secret used to sign admin JWT tokens - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# First super admin, created automatically when the users table is empty
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Public URL of the portal (used in emails)
APP_URL=https://dpgos-careers.k-innovative.com

# SMTP for outgoing mail (welcome emails). Leave empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: display sender, e.g. "Careers Portal <no-reply@yourdomain.com>"
MAIL_FROM=

# Google Drive resume uploads. Two auth options (OAuth wins when both set);
# if neither is set, resumes are stored locally under backend/uploads/resumes.
#
# Option A - OAuth user account (uploads owned by a real Google account):
# mint the refresh token once with: node scripts/get-google-refresh-token.js
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Option B - service account (requires the folder to be in a SHARED DRIVE,
# because service accounts have no storage quota of their own):
# enable the Drive API, share the shared-drive folder with the service
# account email, then set the key (file path OR inline/base64 JSON).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# GOOGLE_SERVICE_ACCOUNT_KEY=
#
# Folder the resumes land in (required for both options)
GOOGLE_DRIVE_FOLDER_ID=

# ---- Cache ----
# Shared cache for the dashboard counters and the hiring-flow dropdown values.
# Leave it EMPTY to use an in-process cache instead, which is equivalent while a
# single backend container serves traffic. Redis becomes necessary when more
# than one backend process runs: an in-process cache would then diverge per
# instance, and one admin's change would show on some page loads and not others.
#
# Every cached key is dropped explicitly by the code that writes it, so the TTL
# is a safety net rather than the correctness mechanism.
REDIS_URL=
CACHE_TTL_SECONDS=60
# Keys are namespaced by database name. Set this only if two environments share
# one Redis and you want the split to be explicit.
CACHE_NAMESPACE=

# ---- Connection pooling ----
# The backend connects through PgBouncer by default in docker-compose.prod.yml.
# To bypass it (the direct-to-PostgreSQL path), set:
#   DB_HOST=postgres
#   DB_PORT=5432
# PG_POOL_SIZE is this process's own pool; behind PgBouncer it can stay small.
PG_POOL_SIZE=10
