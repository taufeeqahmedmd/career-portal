# Dependencies
node_modules/
*/node_modules/

# Build outputs
frontend/build/
dist/

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*.yml
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

