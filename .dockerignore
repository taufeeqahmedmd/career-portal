.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
coverage/
*.test.js
*.spec.js
__tests__/

# Documentation
*.md
!README.md

# Temporary files
tmp/
temp/
*.tmp

